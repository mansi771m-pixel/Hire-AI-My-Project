# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this in your deployed backend environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL for the deployed backend.
# For frontend deployment, set this value in the frontend env as well.
APP_URL="http://localhost:3000"

# VITE_API_URL: Optional override for the frontend API base URL.
# Use this when frontend and backend are hosted separately.
VITE_API_URL="http://localhost:3000"
